{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Picturama",
  "version": "2.0.0",
  "identifier": "io.github.picturama",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3030",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Picturama",
        "backgroundColor": "#1e1e1e",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
        "assetProtocol": {
            "enable": true,
            "scope": ["$HOME/**", "$RESOURCE/**"]
        },
        "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
